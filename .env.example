# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Optional: separate key for OpenRouter fallback (https://openrouter.ai)
# OPENROUTER_API_KEY=

# Where generated files (images, audio, video) are saved
# OUTPUT_DIR=/path/to/output

# Where the learning system keeps its data (interactions, profile, sessions)
# DATA_DIR=/path/to/data

# --- Model overrides (defaults are current as of Oct 2026) ---
# GEMINI_CHAT_MODEL=gemini-3.7-flash
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# GEMINI_IMAGE_PRO_MODEL=gemini-3-pro-image
# GEMINI_VIDEO_MODEL=veo-3.1-generate-001
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Set to 'true' for verbose logs (never logs your API key)
# DEBUG=false
